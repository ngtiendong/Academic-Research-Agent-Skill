flowchart TD
    A["Idea"] --> B["Scope Gate"]
    B --> C["Source Ingestion"]
    C --> D["Literature Grounding"]
    D --> E["Math Formalization"]
    E --> F["Novelty Gate"]
    F --> G["Research Reality Gate"]
    G --> H["Experimental-Unit Audit"]
    H --> I["Feasibility Pilot"]
    I --> J["Claim Freeze"]
    J --> K["Risk and Code Plan"]
    K --> L["Approved Run"]
    L --> M["Reviewer Simulation"]
    M --> N["Claim Verification"]
    N --> O["Draft or Revise"]

    B -. "human approves" .-> B
    F -. "human decides continue, pivot, or stop" .-> F
    G -. "human approves bounded next test" .-> G
    I -. "human decides stop, narrow, or promote" .-> I
    K -. "human approves implementation or full run" .-> K
